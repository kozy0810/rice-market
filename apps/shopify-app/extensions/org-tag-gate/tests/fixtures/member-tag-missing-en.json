{
  "payload": {
    "export": "cart-validations-generate-run",
    "target": "cart.validations.generate.run",
    "input": {
      "cart": {
        "buyerIdentity": {
          "customer": {
            "isMember": false
          }
        }
      },
      "localization": {
        "language": {
          "isoCode": "EN"
        }
      }
    },
    "output": {
      "operations": [
        {
          "validationAdd": {
            "errors": [
              {
                "message": "This store is only available to registered members. Please check the registration URL provided by your dispatch organization.",
                "target": "$.cart"
              }
            ]
          }
        }
      ]
    }
  }
}
